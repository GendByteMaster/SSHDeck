{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSHDeck",
  "version": "0.1.0",
  "identifier": "dev.sshdeck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSHDeck",
        "width": 1320,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
