{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSHDeck",
  "version": "0.1.0",
  "identifier": "dev.sshdeck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSHDeck",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
